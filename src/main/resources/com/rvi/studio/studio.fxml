<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.rvi.studio.StudioController" stylesheets="@theme.css">
    <center>
        <HBox spacing="22" fillHeight="true">
            <padding><Insets top="26" right="28" bottom="22" left="28"/></padding>
            <VBox spacing="14" HBox.hgrow="ALWAYS">
                <Label text="Tag contents" styleClass="page-title"/>
                <HBox spacing="9" alignment="CENTER_LEFT">
                    <ComboBox fx:id="recordType" accessibleText="Record type" prefWidth="146"/>
                    <Button fx:id="addButton" text="Add record" onAction="#addRecord"/>
                </HBox>
                <ListView fx:id="records" accessibleText="NDEF records" VBox.vgrow="ALWAYS"/>
                <HBox spacing="8">
                    <Button fx:id="editButton" text="Edit" onAction="#editRecord"/>
                    <Button fx:id="removeButton" text="Remove" onAction="#removeRecord"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="entryCount" alignment="CENTER_RIGHT" styleClass="muted"/>
                </HBox>
            </VBox>
            <VBox spacing="12" prefWidth="300" minWidth="260" maxWidth="320">
                <VBox spacing="11" styleClass="panel">
                    <Label text="NFC reader" styleClass="panel-title"/>
                    <ComboBox fx:id="readers" maxWidth="Infinity" promptText="Select a reader"
                              accessibleText="NFC reader"/>
                    <Label fx:id="readerStatus" wrapText="true" styleClass="muted"/>
                    <Button fx:id="refreshButton" text="Scan for readers" onAction="#refreshReaders"/>
                </VBox>
                <VBox spacing="11" styleClass="panel">
                    <Label text="Tag storage" styleClass="panel-title"/>
                    <Label fx:id="byteCount" styleClass="storage-count"/>
                    <ProgressBar fx:id="capacityBar" maxWidth="Infinity"
                                 accessibleText="Tag storage used"/>
                    <Label text="Typical NTAG215 capacity, including TLV overhead"
                           wrapText="true" styleClass="muted"/>
                </VBox>
                <Region VBox.vgrow="ALWAYS"/>
                <Button fx:id="readButton" text="Read tag" maxWidth="Infinity" onAction="#readTag"/>
                <Button fx:id="writeButton" text="Write to tag" maxWidth="Infinity"
                        onAction="#writeTag" styleClass="button, primary-action"/>
            </VBox>
        </HBox>
    </center>
    <bottom>
        <HBox alignment="CENTER_LEFT" styleClass="statusbar">
            <Label fx:id="status" wrapText="true"/>
        </HBox>
    </bottom>
</BorderPane>
